{
  "name": "frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "typecheck": "tsc --noEmit",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie globalVariable preferredLanguage baseLocale",
    "build": "vite build",
    "test": "vitest run",
    "check": "biome check",
    "depcheck": "depcruise --config .dependency-cruiser.cjs src",
    "knip": "knip"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.15.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.8",
    "@tanstack/react-form": "^1.28.6",
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-table": "^8.21.3",
    "@vointika/ui": "github:Jefry16/ui#v0.33.0",
    "axios": "^1.14.0",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tanstack/devtools-vite": "0.8.1",
    "@tanstack/router-plugin": "1.168.38",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "dependency-cruiser": "^17.3.10",
    "jsdom": "^28.1.0",
    "knip": "6.35.1",
    "msw": "^2.13.6",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
